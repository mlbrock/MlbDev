# #############################################################################
# #############################################################################
# Basic MLB .gitignore
# #############################################################################
# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Various test executable artifacts
test_*
testpurify_*
testquantify_*
testcoverage_*

# The target platform directory
TargetPlatform/

# Build results logs
BuildResults.*.log

# ----- MSVC++ files extensions to be ignored:
*.bsc
*.exp
*.ilk
*.map
*.pdb
*.sbr
*.sdf
*.suo
*.ncb
*.ipch
*.recipe
*.vcproj.User-PC.User.user
*.vcxproj.user
*.VC.db
*.VC.db-shm
*.VC.db-wal
*.VC.opendb
*.sln.docstates
*.tlog
*.lastbuildstate
*.unsuccessfulbuild

# ----- Windows file extensions to be ignored:
Thumbs.db
Desktop.ini
# #############################################################################

